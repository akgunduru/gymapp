# PostgreSQL connection string used by Prisma.
# prisma.config.ts loads this file with dotenv for Prisma CLI commands.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/social_gym_system?schema=public"

# Auth/session secret for the upcoming credentials authentication module.
AUTH_SECRET="replace-with-a-long-random-secret"

# Optional local upload root. The MVP defaults to public/uploads when unset.
UPLOAD_DIR="public/uploads"

# ── AI Coach (Groq) ────────────────────────────────────────────────────────
# Get a key at: https://console.groq.com/keys
# Uses model: llama-3.3-70b-versatile
# Add this to your real .env file. Never commit the real key — .env is gitignored.
GROQ_API_KEY=your_groq_api_key_here
